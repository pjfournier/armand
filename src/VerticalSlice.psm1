function Read-SliceContent {param([string]$Root=(Split-Path -Parent $PSScriptRoot))$dir=Join-Path $Root 'content/callum_study';[pscustomobject]@{Locations=Get-Content -Raw (Join-Path $dir 'location.json')|ConvertFrom-Json;Objects=Get-Content -Raw (Join-Path $dir 'objects.json')|ConvertFrom-Json;Clues=Get-Content -Raw (Join-Path $dir 'clues.json')|ConvertFrom-Json;Slice=Get-Content -Raw (Join-Path $dir 'slice.json')|ConvertFrom-Json;Polish=Get-Content -Raw (Join-Path $dir 'polish.json')|ConvertFrom-Json;Referents=Get-Content -Raw (Join-Path $dir 'referents.json')|ConvertFrom-Json}}
function New-CallumStudySession {
 param([string]$Root=(Split-Path -Parent $PSScriptRoot))$content=Read-SliceContent $Root;$state=New-GameState
 foreach($loc in $content.Locations.locations){Add-LocationState -State $state -Id $loc.id -VisibleObjects @($loc.visible_objects) -Exits @($loc.exits) -DisplayName $loc.display_name}
 foreach($obj in $content.Objects.objects){$parts=if($obj.PSObject.Properties['parts']){@($obj.parts)}else{@()};Add-ItemState -State $state -Id $obj.id -Location $obj.location -Owner $(if($obj.PSObject.Properties['owner']){$obj.owner}else{$null}) -DisplayName $obj.name -Aliases @($obj.aliases) -InteractableParts $parts}
 foreach($clue in $content.Clues.clues){$tiers=@($clue.tiers|ForEach-Object{[pscustomobject]@{DC=[int]$_.dc;Skill=[string]$_.skill;Fact=[string]$_.fact}});Add-ClueState -State $state -Id $clue.id -Location $clue.location -Tiers $tiers -DisplayName $clue.name -RelatedEntityIds @($clue.related)}
 $state.Player.Location=$content.Slice.start_location;$state.Guillermo.Location=$content.Slice.start_location;Visit-NotebookLocation $state callum_study "Callum's Study" @('a disturbed Victorian study lit by gaslight')|Out-Null;Add-NotebookCharacter $state callum 'Callum' callum_study @('Callum is a missing occult researcher and investigator.') @('Armand came to investigate his disappearance.')|Out-Null
 [pscustomobject]@{Id=[guid]::NewGuid().ToString('N');State=$state;Content=$content;SafeDiscovered=$false;SafeOpen=$false;WindowOpen=$false;LeadRecovered=$false;HintDelivered=$false;VisitCounts=[ordered]@{callum_study=1;landing=0};InteractionCounts=[ordered]@{};CheckHistory=[ordered]@{};ReferentStates=[ordered]@{};PersistentEnvironment=[Collections.Generic.List[object]]::new();RecentReferents=@();PendingIntent=$null;History=[Collections.Generic.List[string]]::new();CreatedUtc=[datetime]::UtcNow}
}
function Get-SlicePlayerState {
 param($Session)$state=$Session.State;$loc=$state.Locations[$state.Player.Location];$visible=@($loc.VisibleObjects|Where-Object{$_-ne'wall_safe'-and$_-ne'burned_note'});if($Session.SafeDiscovered-and$state.Player.Location-eq'callum_study'){$visible+='wall_safe'};if($Session.SafeOpen-and-not$Session.LeadRecovered-and$state.Player.Location-eq'callum_study'){$visible+='burned_note'}
 [pscustomobject]@{session_id=$Session.Id;location=[pscustomobject]@{id=$loc.Id;name=$loc.DisplayName};time=$state.Time.CurrentCaseTime.ToString('h:mm tt');visible_objects=@($visible|ForEach-Object{$state.Items[$_].DisplayName});environment_changes=@($Session.PersistentEnvironment);guillermo=[pscustomobject]@{available=($state.Guillermo.Available-and$state.Guillermo.Alive);communication_tier=$state.Guillermo.CommunicationTier};slice_state=[pscustomobject]@{safe_discovered=$Session.SafeDiscovered;safe_open=$Session.SafeOpen;window_open=$Session.WindowOpen;ending_reached=$Session.LeadRecovered;ending_title=$(if($Session.LeadRecovered){$Session.Content.Slice.ending_title}else{$null});ending_text=$(if($Session.LeadRecovered){$Session.Content.Slice.ending_text}else{$null})};notebook=Get-PlayerFacingNotebook $state}
}
function Get-SliceInterpretationContext {
 param($Session)$state=$Session.State;$loc=$state.Locations[$state.Player.Location];$original=@($loc.VisibleObjects)
 try{
  if($Session.SafeDiscovered-and$state.Player.Location-eq'callum_study'){$loc.VisibleObjects+=@('wall_safe')};if($Session.SafeOpen-and-not$Session.LeadRecovered-and$state.Player.Location-eq'callum_study'){$loc.VisibleObjects+=@('burned_note')}
  $context=New-InterpretationContext $state $Session.RecentReferents;$entities=[Collections.Generic.List[object]]::new();foreach($entity in $context.Entities){$authored=@($Session.Content.Objects.objects|Where-Object{$_.id-eq$entity.Id}|Select-Object -First 1);if($authored.Count-and$authored[0].PSObject.Properties['capabilities']){$entity.Capabilities=@($authored[0].capabilities)};$entities.Add($entity)}
  foreach($ref in $Session.Content.Referents.referents){$available=switch -Regex ([string]$ref.trigger){'^always$'{$true;break}'^clue:(.+)$'{$state.Notebook.Clues.Contains($Matches[1]);break}'^session:safe_discovered$'{$Session.SafeDiscovered;break}'^session:(.+)$'{$Session.ReferentStates.Contains($Matches[1])-or$state.Notebook.Clues.Contains($Matches[1]);break}default{$false}};if($available-and-not@($entities.Id).Contains([string]$ref.id)){$entities.Add((New-EntityReference $ref.id subfeature $ref.display_name @($ref.aliases) @() @($ref.capabilities) $ref.parent $ref.lifecycle))}}
  $context.Entities=@($entities);$context.RecentReferents=@($Session.RecentReferents|Where-Object{@($context.Entities.Id)-contains$_});$context
 }finally{$loc.VisibleObjects=$original}
}
function Find-SliceTarget {
 param([string]$Text,$Context)$hits=@()
 foreach($entity in $Context.Entities){foreach($name in @($entity.DisplayName)+@($entity.Aliases)|Sort-Object Length -Descending -Unique){if($entity.Id-eq'study_room'-and$name-eq'study'-and$Text-match'(?i)\bstudy\s+(?:the|a|an|that|this|it)\b'){continue};if(-not[string]::IsNullOrWhiteSpace($name)-and$Text-match('(?i)(?<![\p{L}\p{N}])'+[regex]::Escape($name)+'(?![\p{L}\p{N}])')){$hits+=[pscustomobject]@{Id=$entity.Id;Alias=$name;Length=$name.Length};break}}}
 if(-not$hits.Count){return [pscustomobject]@{Target=$null;Candidates=@();Alias=$null}}
 $max=($hits|Measure-Object Length -Maximum).Maximum;$best=@($hits|Where-Object Length -eq $max);[pscustomobject]@{Target=$(if(@($best.Id|Select-Object -Unique).Count-eq1){$best[0].Id}else{$null});Candidates=@($best.Id|Select-Object -Unique);Alias=$best[0].Alias}
}
function New-SliceIntentResult {
 param([string]$Text,[string]$Actor,[string]$Action,$Target,$Method,$Spell,$Area,$Purpose,$SecondaryTarget,[string[]]$Modifiers=@(),$Alias,[bool]$RecentUsed=$false)
 [pscustomobject]@{Status='RESOLVED';OutcomeCategory='MEANINGFUL';Intent=[pscustomobject]@{actor=$Actor.ToLowerInvariant();action=$Action;target=$Target;secondary_target=$SecondaryTarget;method=$Method;area=$Area;communicative_intent=$null;spell=$Spell;purpose=$Purpose;modifiers=@($Modifiers);raw_input=$Text};Reason=$null;Clarification=$null;AliasesMatched=@($(if($Alias){$Alias}));RecentReferentUsed=$RecentUsed;RoutingFamily=$Action;RawModelStructuredOutput='slice_semantic_route';ElapsedSeconds=0.0}
}
function New-SliceClarification {param([string]$Reason,[string]$Text,[string[]]$Candidates=@())$labels=@($Candidates|ForEach-Object{$_-replace'_',' '});[pscustomobject]@{Status='NEEDS_CLARIFICATION';OutcomeCategory='AMBIGUOUS';Intent=$null;Reason=$Reason;Clarification=$(if($Reason-eq'ambiguous_marks'){"Which marks do you mean, the scorch marks by the hearth or the dark stain by the rug?"}elseif($labels.Count){"Which do you mean: $($labels-join', ')?"}else{$Text});AliasesMatched=@();RecentReferentUsed=$false;RoutingFamily=$null;RawModelStructuredOutput='slice_semantic_clarification';ElapsedSeconds=0.0}}
function Add-SliceTurnMetadata {param($Result,[string[]]$Inherited=@(),[string]$PendingEvent='none',[bool]$Compound=$false)$Result|Add-Member -NotePropertyName InheritedFromPending -NotePropertyValue @($Inherited) -Force;$Result|Add-Member -NotePropertyName PendingEvent -NotePropertyValue $PendingEvent -Force;$Result|Add-Member -NotePropertyName CompoundDetected -NotePropertyValue $Compound -Force;$Result}
function Invoke-SliceInterpretation {
 [CmdletBinding()]param($Session,[string]$PlayerText,[scriptblock]$Backend,[string]$DebugLogPath,[Nullable[int]]$Seed)
 $watch=[Diagnostics.Stopwatch]::StartNew();$context=Get-SliceInterpretationContext $Session
 $gestureToGuillermo=$PlayerText-match'(?i)^\s*(?:wave|whistle|point|beckon|snap|clap|smile|pet)\b.*\bGuillermo\b|^\s*wave\s+at\s+Guillermo\s+and\s+whistle'
 $windowOpenPhrase=$PlayerText-match'(?i)^\s*go?t?\s+to\s+(?:the\s+)?window\s+and\s+(?:try\s+to\s+)?open\s+it'
 $trueCompound=$PlayerText-match'(?i)\b(and then|then|after that|and\s+(?:have|ask|tell|send)\s+Guillermo)\b'-or($PlayerText-match'(?i)\band\s+(?:look|inspect|examine|search|open|close|leave|move|take|read|cast|use)\b'-and$PlayerText-notmatch'(?i)\band\s+(?:see|determine|check|figure|work out)\b')
 if($trueCompound-and-not$gestureToGuillermo-and-not$windowOpenPhrase){$Session.PendingIntent=$null;$watch.Stop();$r=New-SliceClarification compound 'That contains two actions. Which should happen first?';$r.ElapsedSeconds=$watch.Elapsed.TotalSeconds;return (Add-SliceTurnMetadata $r @() 'cleared_compound' $true)}
 if($PlayerText-match'(?i)^\s*(?:cancel|never mind|nevermind)\b'){$Session.PendingIntent=$null;$watch.Stop();$r=New-SliceClarification canceled 'All right. What do you want to do instead?';$r.ElapsedSeconds=$watch.Elapsed.TotalSeconds;return (Add-SliceTurnMetadata $r @() 'cleared_canceled')}
 $match=Find-SliceTarget $PlayerText $context;$target=$match.Target;$recentUsed=$false
 if($match.Candidates.Count-gt1){$watch.Stop();$r=New-SliceClarification $(if($match.Alias-match'(?i)marks?'){'ambiguous_marks'}else{'ambiguous_target'}) $null $match.Candidates;$r.ElapsedSeconds=$watch.Elapsed.TotalSeconds;return $r}
 if(-not$target-and$PlayerText-match'(?i)\b(it|that|those|them)\b'){$recent=@($context.RecentReferents|Select-Object -Unique);if($recent.Count-eq1){$target=$recent[0];$recentUsed=$true}elseif($recent.Count-gt1){$watch.Stop();$r=New-SliceClarification recent 'Which recent object do you mean?' $recent;$r.ElapsedSeconds=$watch.Elapsed.TotalSeconds;return $r}}
 if($PlayerText-match'(?i)^\s*look down at (?:the )?floor\b'){$target='rug';$match=[pscustomobject]@{Alias='floor'}}
 if($null-ne$Session.PendingIntent-and$target-and$PlayerText-match'(?i)^\s*(?:the |that )?[\p{L}\p{N}_ -]+[.!?]?\s*$'-and$PlayerText-notmatch'(?i)\b(?:look|inspect|examine|search|investigate|read|open|unlock|take|move|go|walk|step|cast|use|ask|tell|have|send|wait)\b'){$pending=$Session.PendingIntent;$Session.PendingIntent=$null;$watch.Stop();$r=New-SliceIntentResult $PlayerText $pending.actor $pending.action $target $pending.method $pending.spell $pending.area $pending.purpose $null @() $match.Alias $false;$r.ElapsedSeconds=$watch.Elapsed.TotalSeconds;return (Add-SliceTurnMetadata $r @('target') 'consumed')}
 if($PlayerText-match'(?i)^\s*(?:how|what\s+(?:colou?r|size|width|height|depth))\b'){$Session.PendingIntent=$null;$property=if($PlayerText-match'(?i)\b(?:high|height)\b'){'height'}elseif($PlayerText-match'(?i)\b(?:wide|width)\b'){'width'}elseif($PlayerText-match'(?i)\b(?:big|size|large)\b'){'size'}elseif($PlayerText-match'(?i)\bfar\b'){'distance'}elseif($PlayerText-match'(?i)\bheavy\b'){'weight'}elseif($PlayerText-match'(?i)\b(?:deep|depth)\b'){'depth'}elseif($PlayerText-match'(?i)\bcolou?r\b'){'color'}else{'unknown'};$watch.Stop();$r=New-SliceIntentResult $PlayerText armand query_property $target $null $null $null $null $null @() $match.Alias $false;$r.Intent|Add-Member -NotePropertyName property -NotePropertyValue $property;$r.ElapsedSeconds=$watch.Elapsed.TotalSeconds;return (Add-SliceTurnMetadata $r @() 'cleared_query')}
 if($PlayerText-match'(?i)^\s*(?:is|are|do|does|can|have\s+I|has\s+the)\b'){$Session.PendingIntent=$null;$queryTarget=$target;if(-not$queryTarget){$queryTarget=if($PlayerText-match'(?i)\b(?:fire|hearth|fireplace)\b'){'fireplace'}elseif($PlayerText-match'(?i)\bwindow\b'){'window'}elseif($PlayerText-match'(?i)\bdoor\b'){'study_door'}elseif($PlayerText-match'(?i)\bGuillermo\b'){'guillermo'}elseif($PlayerText-match'(?i)\bsafe\b'){'wall_safe'}elseif($PlayerText-match'(?i)\bnote\b'){'burned_note'}elseif($PlayerText-match'(?i)\b(?:blood|stain|discoloration)\b'){'bloodstain'}else{$null}};$watch.Stop();$r=New-SliceIntentResult $PlayerText armand query_state $queryTarget $null $null $null $null $null @() $match.Alias $false;$r.ElapsedSeconds=$watch.Elapsed.TotalSeconds;return (Add-SliceTurnMetadata $r @() 'cleared_query')}
 $actor=if($PlayerText-match'(?i)\b(send|have|ask|tell)\s+Guillermo\b|^\s*Guillermo\b'){'guillermo'}else{'armand'}
 if($actor-eq'guillermo'-and$target-eq'guillermo'-and$PlayerText-notmatch'(?i)^\s*ask Guillermo\b'){$withoutGuillermo=$context.PSObject.Copy();$withoutGuillermo.Entities=@($context.Entities|Where-Object{$_.Id-ne'guillermo'});$alternate=Find-SliceTarget $PlayerText $withoutGuillermo;if($alternate.Target){$match=$alternate;$target=$match.Target}}
 $area=if($PlayerText-match'(?i)\b(under|underneath|beneath|below)\b'){'underneath'}elseif($PlayerText-match'(?i)\b(?:top|on top)\b'){'on_top'}elseif($PlayerText-match'(?i)\bbehind\b'){'behind'}elseif($PlayerText-match'(?i)\binside\b'){'inside'}elseif($PlayerText-match'(?i)\baround\b'){'around'}else{$null}
 $modifiers=@(@('quietly','carefully','quickly','without touching')|Where-Object{$PlayerText-match('(?i)\b'+[regex]::Escape($_)+'\b')})
 $explicitMethod=if($PlayerText-match'(?i)\b(?:with|using|use)\s+(?:the |a |an |my )?([\p{L}\p{N}_ -]+?)(?:\s+(?:to|for|and)\b|[.!?]|$)'){$Matches[1].Trim()}else{$null}
 if($PlayerText-match'(?i)\b(?:use|using|with)\s+(?:the |my )?(crowbar|pry bar)\b.*\b(?:open|unlock|force|pry)\b.*\bsafe\b'-and@($context.Entities.Id)-contains'wall_safe'){$target='wall_safe';$explicitMethod='crowbar';$match=[pscustomobject]@{Alias='safe'}}
 $purpose=$null
 if($PlayerText-match'(?i)\b(?:to|and)\s+(?:see|check|determine|work out|figure out|examine|inspect|look)\s+(.+)$'){$purpose=$Matches[1].Trim(' .')}
 elseif($PlayerText-match'(?i)\b(?:for|whether)\s+(.+)$'){$purpose=$Matches[1].Trim(' .')}
 if($PlayerText-match'(?i)(book.+fit|what (?:sort|kind) of book|what was removed|shelf wear)'-and@($context.Entities.Id)-contains'bookshelf_gap'){$target='bookshelf_gap';$purpose='infer the size or identity of the missing book'}
 elseif($target-eq'receipt'-and$PlayerText-match'(?i)addresses?'){$purpose='determine whether the receipts contain addresses'}
 elseif($target-eq'receipt'-and$PlayerText-match'(?i)(where Callum|travel|been)'){$purpose='determine whether the receipts indicate Callum''s recent whereabouts or travel'}
 elseif($target-eq'rope_fibers'-and$PlayerText-match'(?i)(which way|direction|dragged)'){$purpose='determine the direction in which the rope was dragged'}
 elseif($target-eq'scorch_marks'-and$PlayerText-match'(?i)(ordinary fire|cause|came from)'){$purpose='determine whether the marks came from an ordinary fire'}
 $spell=$null;foreach($candidate in $context.Spells){if($PlayerText-match('(?i)(?<![\p{L}\p{N}])'+[regex]::Escape($candidate.Name)+'(?![\p{L}\p{N}])')){$spell=$candidate.Id;break}}
 if(-not$spell-and$PlayerText-match'(?i)\b(blink|teleport)\b'-and@($context.Spells.Id)-contains'misty_step'){$spell='misty_step'}
 if($gestureToGuillermo){$actor='armand';$action='gesture';$target='guillermo';$method=$(if($PlayerText-match'(?i)whistle'){'wave and whistle'}else{([regex]::Match($PlayerText,'(?i)wave|point|beckon|snap|clap|smile|pet').Value.ToLowerInvariant())})}
 elseif($windowOpenPhrase){$actor='armand';$action='open';$target='window';$method='latch'}
 elseif($spell){$action='cast';$method=$null}
 elseif($PlayerText-match'(?i)\b(send|have)\s+Guillermo\b'){$action='examine';$method=$null}
 elseif($PlayerText-match'(?i)^\s*ask Guillermo\b'){$actor='armand';$action='speak';$target='guillermo';$method='ask'}
 elseif($PlayerText-match'(?i)\b(read|open (?:an? )?(?:letter|correspondence))\b'){$action='read';$method='read'}
 elseif($PlayerText-match'(?i)\b(?:open|unlock|close)\b'){$action=if($PlayerText-match'(?i)\bunlock\b'){'unlock'}elseif($PlayerText-match'(?i)\bclose\b'){'manipulate'}else{'open'};$method=$(if($PlayerText-match'(?i)\bclose\b'){'close'}else{$explicitMethod})}
 elseif($PlayerText-match'(?i)^\s*(?:take(?!\s+a\s+closer\s+look)|pick up|grab)\b'){$action='take';$method=$null}
 elseif($PlayerText-match'(?i)^\s*(move|lift|shift|push|pull|turn|roll|drag)\b'-and$target-and$PlayerText-notmatch'(?i)^\s*move\s+(?:toward|towards|to|into|through)\b'){$action='manipulate';$method=$Matches[1].ToLowerInvariant()}
 elseif($PlayerText-match'(?i)\b(knock|poke|rifle|rummage)\b'){$action=if($PlayerText-match'(?i)rifle|rummage'){'search'}else{'manipulate'};$method=([regex]::Match($PlayerText,'(?i)\b(knock|poke|rifle|rummage)\b').Value.ToLowerInvariant())}
 elseif($PlayerText-match'(?i)^\s*(move|go|walk|step|enter|leave)\b'){$action='move';$method=$null}
 elseif($PlayerText-match'(?i)\b(search|investigate|study|work out|figure out)\b'){$action='investigate';$method=$null}
 elseif($PlayerText-match'(?i)\b(smell|sniff)\b'){$action='examine';$method='smell'}
 elseif($PlayerText-match'(?i)\b(touch|feel)\b'){$action='examine';$method='touch'}
 elseif($PlayerText-match'(?i)\b(stare|gaze)\b'){$action='examine';$method='stare'}
 elseif($PlayerText-match'(?i)\b(look|inspect|examine|check|peer|see)\b'){$action='examine';$method=$(if($area-eq'underneath'){'look_under'}else{$null})}
 else{$action=$null;$method=$null}
 if(-not$method-and$explicitMethod-and-not$spell){$method=$explicitMethod}
 if($action-eq'manipulate'-and$area-eq'underneath'){$purpose='examine underneath'}
 if(-not$target-and$PlayerText-match'(?i)\blight\s+(?:a|the)?\s*fire\b.*\b(?:spell|magic)'){$Session.PendingIntent=[pscustomobject]@{actor='armand';action='cast';method=$null;spell='fire_bolt';area=$null;purpose='ignite a fire';missing=@('target');created_turn=$Session.State.Time.Turn};$watch.Stop();$r=New-SliceClarification missing_target 'Where do you want to direct the fire spell?';$r.ElapsedSeconds=$watch.Elapsed.TotalSeconds;return (Add-SliceTurnMetadata $r @() 'created')}
 if($action-and$target){if($null-ne$Session.PendingIntent){$Session.PendingIntent=$null;$pendingEvent='cleared_unrelated'}else{$pendingEvent='none'};$watch.Stop();$r=New-SliceIntentResult $PlayerText $actor $action $target $method $spell $area $purpose $null $modifiers $match.Alias $recentUsed;$r.ElapsedSeconds=$watch.Elapsed.TotalSeconds;return (Add-SliceTurnMetadata $r @() $pendingEvent)}
 $result=Invoke-IntentInterpretation $PlayerText $context $Backend $DebugLogPath $Seed;if($result.Intent){foreach($field in @('secondary_target','purpose','modifiers')){if(-not$result.Intent.PSObject.Properties[$field]){$result.Intent|Add-Member -NotePropertyName $field -NotePropertyValue $(if($field-eq'modifiers'){@()}else{$null})}}};$result|Add-Member -NotePropertyName OutcomeCategory -NotePropertyValue $(if($result.Status-eq'NEEDS_CLARIFICATION'){'AMBIGUOUS'}elseif($result.Status-eq'UNRECOGNIZED'){'UNRECOGNIZED'}else{'MEANINGFUL'}) -Force;$result|Add-Member -NotePropertyName AliasesMatched -NotePropertyValue @($(if($match.Alias){$match.Alias})) -Force;$result|Add-Member -NotePropertyName RecentReferentUsed -NotePropertyValue $recentUsed -Force;$result|Add-Member -NotePropertyName RoutingFamily -NotePropertyValue $(if($result.Intent){$result.Intent.action}else{$null}) -Force
 if($result.Intent){foreach($field in @('method','area','communicative_intent','spell','secondary_target','purpose')){if(-not$result.Intent.PSObject.Properties[$field]){$result.Intent|Add-Member -NotePropertyName $field -NotePropertyValue $null}};if(-not$result.Intent.PSObject.Properties['modifiers']){$result.Intent|Add-Member -NotePropertyName modifiers -NotePropertyValue @()}};if($null-ne$Session.PendingIntent){$Session.PendingIntent=$null;$pendingEvent='cleared_unrelated'}else{$pendingEvent='none'};Add-SliceTurnMetadata $result @() $pendingEvent
}
function Get-ClueDelta {param($Before,$After)$old=@{};foreach($c in @($Before.Clues.PSObject.Properties.Value)){$old[$c.clue_id]=@($c.known_facts).Count};$changes=@();foreach($c in @($After.Clues.PSObject.Properties.Value)){if(-not$old.ContainsKey($c.clue_id)-or@($c.known_facts).Count-gt$old[$c.clue_id]){$changes+=$c}};@($changes)}
function Invoke-SliceClue {param($Session,[string]$ClueId,[string]$Skill,[int]$Score)$result=Resolve-ClueInterpretation $Session.State $ClueId $Skill $Score;if($result.NewFacts.Count){Visit-NotebookLocation $Session.State callum_study "Callum's Study" @() @($ClueId)|Out-Null};$result}
function Get-SliceMundaneResult {param($Session,[string]$Target,[string]$Action,[string]$Method)$entry=$Session.Content.Polish.mundane_results.PSObject.Properties[$Target];if($null-eq$entry){return $null};$values=$entry.Value;$key=if($Method-in@('look_under','smell','touch','stare','knock')){$Method}elseif($Action-eq'read'){'read'}elseif($Action-eq'manipulate'){'manipulate'}elseif($Target-eq'window_latch'){'inspect'}elseif($Target-eq'guillermo' -and $Action-eq'speak'){'ask'}else{'repeat'};$property=$values.PSObject.Properties[$key];if($property){[string]$property.Value}else{$null}}
function Invoke-SliceActiveClueCheck {
 param($Session,$Intent,[string]$ClueId,[string]$Skill,[Nullable[int]]$FixedRoll)
 $clue=$Session.State.Clues[$ClueId];$next=@($clue.Tiers|Where-Object{$_.Skill-eq$Skill-and-not$clue.KnownFacts.Contains([string]$_.Fact)}|Sort-Object DC|Select-Object -First 1);if(-not$next.Count){return [pscustomobject]@{Repeated=$true;Check=$null;NewFacts=@()}}
