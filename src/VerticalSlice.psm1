function Invoke-SliceNarration {
 param($Session,$Resolution,[scriptblock]$NarratorBackend,[int]$MaxAttempts=2,[string]$Root=(Split-Path -Parent $PSScriptRoot))
 if($Resolution.Handoff.Attempt.Action-in@('query_state','query_property','gesture','move')-or($Resolution.Handoff.Attempt.Action-eq'cast'-and(@($Resolution.Events)-join' ')-match'(?i)vanishes through a curl of mist')){$text=Get-SafeFallbackNarration $Resolution;$valid=[pscustomobject]@{Passed=$true;Lexical=$null;Structural=$null;GroundingErrors=@();RawOutput=$text;ValidatedOutput=$text};return [pscustomobject]@{Text=$text;RawOutputs=@();Validations=@($valid);Validation=$valid;RetryOccurred=$false;FallbackUsed=$false;ElapsedSeconds=0.0;PromptCharacters=0;PromptBytes=0}}
 $case=Convert-HandoffToNarrationCase $Resolution.Handoff $Session.State.Player.Location $Session.State.Time.CurrentCaseTime.ToString('h:mm tt') rain;$packet=ConvertTo-NarrationPacket $case;$allExamples=@(Read-NarrationExemplars (Join-Path $Root 'exemplars/playability_polish_exemplars.json') -ExpectedCount 7);$ids=if($Resolution.Handoff.Attempt.Action-eq'gesture'){@('guillermo-gesture')}elseif($Resolution.Handoff.Attempt.Action-eq'query_property'){@('property-query')}elseif($Resolution.Handoff.Attempt.Target-match'correspondence|letter'){@('correspondence-dry','ordinary-atmospheric')}elseif($Resolution.Check-and$Resolution.Degree-match'Failure|Setback'){@('failed-check','ordinary-atmospheric')}elseif($Resolution.Handoff.Attempt.Target-match'blood|discoloration|fiber|scorch'){@('clue-tier','ordinary-atmospheric')}elseif($Resolution.Classification-eq'MUNDANE'){@('mundane-dry','ordinary-atmospheric')}else{@('ordinary-atmospheric')};$examples=@($allExamples|Where-Object{$_.id-in$ids});$prompt=Build-NarrationPrompt $packet facts $examples;$raws=@();$validations=@();$lastValidation=$null;$elapsed=0.0
 for($i=0;$i-lt$MaxAttempts;$i++){$watch=[Diagnostics.Stopwatch]::StartNew();if($null-ne$NarratorBackend){$g=&$NarratorBackend $prompt $i}else{$work=Join-Path $Root 'eval/.work';New-Item -ItemType Directory -Force $work|Out-Null;$path=Join-Path $work "slice_narrator_$([guid]::NewGuid().ToString('N')).txt";$prompt|Set-Content -NoNewline -Encoding utf8 $path;$cfg=Join-Path $Root 'config.json';$g=Invoke-CommaGeneration $path $cfg -Seed (12000+$Session.State.Time.Turn+$i) -Temperature .15 -MaxTokens 160};$watch.Stop();$elapsed+=$watch.Elapsed.TotalSeconds;$raw=[string]$(if($g.PSObject.Properties['Text']){$g.Text}else{$g.RawOutput});$raws+=$raw;$text='You '+(($raw-replace'(?s)\s*FACTS\s*$','').TrimStart());$base=Test-NarrationOutput $text @($Session.Content.Slice.hidden_truth) 120 $Resolution.Handoff.Attempt.Actor;$lastValidation=Test-SliceNarrationGrounding $Session $Resolution $text $base;$validations+=$lastValidation;if($lastValidation.Passed){return [pscustomobject]@{Text=$text;RawOutputs=$raws;Validations=$validations;Validation=$lastValidation;RetryOccurred=($i-gt0);FallbackUsed=$false;ElapsedSeconds=$elapsed;PromptCharacters=$prompt.Length;PromptBytes=[Text.Encoding]::UTF8.GetByteCount($prompt)}}}
 [pscustomobject]@{Text=(Get-SafeFallbackNarration $Resolution);RawOutputs=$raws;Validations=$validations;Validation=$lastValidation;RetryOccurred=($MaxAttempts-gt1);FallbackUsed=$true;ElapsedSeconds=$elapsed;PromptCharacters=$prompt.Length;PromptBytes=[Text.Encoding]::UTF8.GetByteCount($prompt)}
}

